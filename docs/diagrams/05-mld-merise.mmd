    users {
        bigint id PK
        string name
        string email UK
        string role
        bigint boutique_id FK
    }

    cities {
        bigint id PK
        string name UK
        string slug UK
    }

    boutiques {
        bigint id PK
        string name
        bigint city_id FK
        boolean is_verified
    }

    products {
        bigint id PK
        string name
        decimal price
        int stock_quantity
        bigint boutique_id FK
        bigint category_id FK
    }

    orders {
        bigint id PK
        bigint user_id FK
        decimal total
        string status
    }

    order_items {
        bigint id PK
        bigint order_id FK
        bigint product_id FK
        int quantity
    }
