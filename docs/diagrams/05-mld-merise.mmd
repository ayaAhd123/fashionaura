    users ||--o{ reviews : "user_id"
    users ||--o{ conversations : "customer_id"
    users ||--o{ carts : "user_id"
    users ||--o{ favorites : "user_id"
    users ||--o{ boutique_followers : "user_id"

    cities ||--|{ boutiques : "city_id"
    boutiques ||--|{ products : "boutique_id"
    categories ||--|{ products : "category_id"
    boutiques ||--|{ boutique_posts : "boutique_id"
    boutiques ||--|{ reviews : "boutique_id"

    orders ||--|{ order_items : "order_id"
    products ||--o{ order_items : "product_id"
    carts ||--|{ cart_items : "cart_id"
    products ||--o{ cart_items : "product_id"

    conversations ||--|{ messages : "conversation_id"
